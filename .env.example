# Vite server configuration
PORT=5173
BASE_PATH=/

# Local dashboard login.
# This is bundled into the frontend by Vite, so use it only as a lightweight
# access gate. Production deployments should use server-side authentication.
# Prefer the SHA-256 hash in deployed builds so the plain password is not bundled.
VITE_APP_PASSWORD_HASH=
VITE_APP_PASSWORD=replace-with-a-strong-password

# Optional Google Apps Script sync integration
VITE_APPS_SCRIPT_URL=
VITE_APPS_SCRIPT_TOKEN=
